# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the browser.
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret used to sign QR attendance tokens. Generate with:
#   openssl rand -base64 32
QR_TOKEN_SECRET=change-me-to-a-long-random-string

# Optional: regex that valid student IDs must match on masterlist import.
# Defaults to ^\d{2}-\d{4,6}$ (e.g. 21-00123).
# NEXT_PUBLIC_STUDENT_ID_PATTERN=^\d{2}-\d{4,6}$

# Secret for the daily keep-alive job (Vercel Cron → /api/cron/keep-alive),
# which stops a free Supabase project from pausing. Generate with:
#   openssl rand -base64 32
CRON_SECRET=change-me-to-another-long-random-string
